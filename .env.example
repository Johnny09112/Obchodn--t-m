# VOLITELNÉ. Bez vyplnění běží databáze LOKÁLNĚ v data/pgdata — což je
# výchozí a doporučený režim. Vyplň jen tehdy, když chceš cloudový Postgres.
DATABASE_URL=

# VOLITELNÉ. Provoz jede na předplatném (agent v Claude Code), API klíč tedy
# není potřeba. Vyplň jen pro bezobslužný běh přes API (např. pro klienta).
ANTHROPIC_API_KEY=

# Kontaktní e-mail do User-Agent pro Nominatim (vyžadováno podmínkami užití).
NOMINATIM_CONTACT=
