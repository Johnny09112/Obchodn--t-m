# Vzor nastavení. Skutečný soubor NEPATŘÍ do téhle složky.
#
# Zkopíruj ho do ~/.cantinero/.env (na Windows C:\Users\<ty>\.cantinero\.env)
# a vyplň až tam. Jinou cestu určíš proměnnou CANTINERO_ENV.
#
# Proč mimo projekt: Čmuchal tu běží bez dozoru a čte cizí weby. Ověřeno
# 6. 8. 2026, že omezení nástrojů mu ve čtení souborů nezabrání — jediná
# spolehlivá obrana je tajemství tady prostě nemít.

# VOLITELNÉ. Bez vyplnění běží databáze LOKÁLNĚ v data/pgdata — což je
# výchozí a doporučený režim. Vyplň jen tehdy, když chceš cloudový Postgres.
DATABASE_URL=

# VOLITELNÉ. Provoz jede na předplatném (agent v Claude Code), API klíč tedy
# není potřeba. Vyplň jen pro bezobslužný běh přes API (např. pro klienta).
ANTHROPIC_API_KEY=

# Kontaktní e-mail do User-Agent pro Nominatim (vyžadováno podmínkami užití).
NOMINATIM_CONTACT=
